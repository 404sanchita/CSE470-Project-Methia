{
    "name": "methia-travel-platform",
    "version": "1.0.0",
    "description": "Methia Travel Platform - Full Stack MERN Application",
    "main": "server.mjs",
    "scripts": {
      "start": "node server.mjs",
      "dev": "node --watch server.mjs",
      "client": "react-scripts start",
      "client-install": "npm install react react-dom react-router-dom axios react-scripts --save",
      "install-all": "npm install && npm run client-install",
      "db:init": "node scripts/initDatabase.js",
      "create-admin": "node scripts/createAdmin.js"
    },
    "dependencies": {
      "axios": "^1.5.0",
      "bcryptjs": "^2.4.3",
      "cors": "^2.8.5",
      "dotenv": "^16.3.1",
      "express": "^4.18.2",
      "jsonwebtoken": "^9.0.2",
      "mongoose": "^7.5.0",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "react-router-dom": "^6.16.0",
      "react-scripts": "5.0.1",
      "web-vitals": "^5.1.0"
    },
    "keywords": [
      "travel",
      "booking",
      "api",
      "mern"
    ],
    "author": "",
    "license": "ISC",
    "browserslist": {
      "production": [
        ">0.2%",
        "not dead",
        "not op_mini all"
      ],
      "development": [
        "last 1 chrome version",
        "last 1 firefox version",
        "last 1 safari version"
      ]
    }
  }
  